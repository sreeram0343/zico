# ==============================================================================
# ZICO Intelligent Travel Operations Assistant - Example Configuration
# ==============================================================================
# NOTE: Never commit production credentials, secret keys, or passwords.
# Copy this template to .env and configure the respective API keys.

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI LLM & Whisper Transcription
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AviationStack Flight Data API
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
DEFAULT_ORIGIN_IATA=BOM

# Search Provider (Tavily Travel Research)
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# PostgreSQL Persistent Application Database
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zico
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/zico

# Redis Cache, Memory & Session State
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=travel_policies

# Voice & Speech Synthesis (ElevenLabs / EdgeTTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Rate Limiting & Service Timeouts
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
OPENAI_TIMEOUT_SECONDS=15.0
AVIATIONSTACK_TIMEOUT_SECONDS=10.0
TAVILY_TIMEOUT_SECONDS=10.0
QDRANT_TIMEOUT_SECONDS=5.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
